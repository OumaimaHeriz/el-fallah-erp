{
  "name": "el-fallah-erp",
  "productName": "EL-FALLAH ERP",
  "version": "1.0.0",
  "type": "module",
  "description": "نظام إدارة زراعي وتجاري جزائري لمزارع النخيل وتجارة التمور (بسكرة/طولقة)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:dmg": "npm run build && mkdir -p release && hdiutil create -volname 'EL-FALLAH ERP' -srcfolder dist -ov -format UDZO release/EL-FALLAH-ERP-v1.0.0.dmg"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^32.1.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "vite": "^5.4.3",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
